rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Per-line shape guard for order creation (defense in depth — the
    // authoritative price check lives server-side: a line must be EXACTLY the
    // shape submitOrder writes).
    // NOTE: rules cannot join the products catalog to verify prices — the
    // authoritative price/total verification lives in api/create-preference.ts
    // (catalog rebuild) and api/webhooks/mercadopago.ts (amount assertion).
    function isValidOrderItem(item) {
      return item is map
        && item.keys().hasOnly(['productId', 'name', 'quantity', 'price'])
        && item.productId is string && item.productId.size() > 0 && item.productId.size() <= 64
        && item.name is string && item.name.size() <= 200
        // Quantity ceiling: it must never be tighter than what checkout can offer,
        // or a legitimate bulk line would be rejected wholesale and surface only as
        // a generic checkout failure. The cart caps a line at the product's
        // `stockCount`, and `stockCount` is admin-capped at MAX_STOCK_UNITS
        // (1,000,000, api/_lib/admin/adminLimits.ts) — so this bound is that same
        // figure. It still rejects the ~2^31 value an unauthenticated caller could
        // otherwise store. Rules cannot import the constant; the sync is pinned by
        // the order-create contract test.
        && item.quantity is int && item.quantity >= 1 && item.quantity <= 1000000
        // Integer CLP only — CLP has no cents, and a fractional price would
        // store an amount the payment/SII layers can never reproduce.
        && item.price is int && item.price >= 0;
    }

    // ── The order-create contract ─────────────────────────────────────────────
    // `orders` is a PUBLIC create (checkout runs client-side), so the rules must
    // describe EXACTLY the document src/services/api.ts `submitOrder()` writes.
    // The client Firestore instance runs with `ignoreUndefinedProperties: true`,
    // so the optional keys below are usually absent rather than null.
    // Without these guards any visitor could (a) store a decoy document whose
    // `orderId` field points at another order's id, (b) pre-inject admin-only
    // fields (voucherUrl, approvedAt, dispatch, trackingNumber, …) or (c) write
    // ~1 MiB of junk in a single call.
    function isBoundedString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isValidTaxBreakdown(t) {
      return t.keys().hasOnly(['neto', 'iva', 'total'])
        && t.neto is int && t.iva is int && t.total is int
        // The exact gross→neto decomposition: neto = round(total / 1.19) and
        // iva = total − neto, the same math calculateTaxBreakdown() applies —
        // so a stored breakdown can carry no decomposition other than the real
        // one (e.g. iva: 0). The binding to totalAmount lives in isValidBilling.
        && t.neto == math.round(t.total / 1.19)
        && t.neto + t.iva == t.total;
    }

    function isValidSanitaryVerification(s) {
      return s.keys().hasOnly(['sisRegistryNumber', 'credentialFileName', 'verified', 'regulatoryNote'])
        && isBoundedString(s.sisRegistryNumber, 40)
        && s.verified is bool
        && isBoundedString(s.regulatoryNote, 300)
        && (!('credentialFileName' in s) || isBoundedString(s.credentialFileName, 200));
    }

    // `paymentMethod` is passed in: the delivery zone is pinned to the two
    // communes checkout delivers to, EXCEPT for a WhatsApp quote order, whose
    // buyer is outside the zone and settles the delivery in a direct chat
    // (only a bounded free-text commune is then accepted).
    function isValidCustomer(c, paymentMethod) {
      return c.keys().hasOnly([
          'fullName', 'email', 'phone', 'rut', 'documentType',
          'razonSocial', 'giroComercial', 'address', 'city', 'zip',
          'transferReceipt', 'sanitaryVerification'
        ])
        && isBoundedString(c.fullName, 120)
        && isBoundedString(c.email, 160)
        // Shape only — the send itself is the delivery authority. The pattern is
        // deliberately no stricter than the checkout's own `type="email"` validity:
        // HTML5 accepts a dotless domain, so requiring a dot here would reject an
        // address the form accepted and dead-end checkout with a generic error.
        && c.email.matches('^[^@]+@[^@]+$')
        && isBoundedString(c.phone, 32)
        && isBoundedString(c.rut, 16)
        // Canonical RUT storage: `12345678-5` (7-8 digits, hyphen, check
        // digit 0-9 or K). Rules cannot express Modulo 11 (no loops, no
        // string arithmetic), so this is a shape pin; the checkout's
        // validateRut() gate remains the check-digit authority.
        && c.rut.matches('^[0-9]{7,8}-[0-9K]$')
        // Boleta-only as built: the Factura checkout path is disabled
        // (`FACTURA_ENABLED = false` in CheckoutModal.tsx — Factura requests
        // route through the WhatsApp quotation flow). Re-enabling Factura
        // means flipping that flag AND this pin together.
        && c.documentType == 'boleta'
        && isBoundedString(c.address, 200)
        // Delivery zones: Melipilla (same-day) and San Antonio (scheduled
        // route) are the only two communes checkout's `Comuna de Despacho`
        // select offers — mirrored here from DELIVERY_ZONES in
        // src/config/delivery.ts (rules cannot import config). A WhatsApp
        // quote order is the one exception: its buyer is outside the zone and
        // settles delivery in a direct chat, so only a bounded free-text
        // commune is required there.
        && (
          c.city in ['Melipilla', 'San Antonio']
          || (paymentMethod == 'whatsapp' && isBoundedString(c.city, 80) && c.city.size() > 0)
        )
        && isBoundedString(c.zip, 16)
        // Documented CustomerInfo field; no current writer sets it, but leaving it
        // out of the allowlist would make any future caller's payload fail wholesale.
        && (!('transferReceipt' in c) || isBoundedString(c.transferReceipt, 120))
        && (!('razonSocial' in c) || isBoundedString(c.razonSocial, 160))
        && (!('giroComercial' in c) || isBoundedString(c.giroComercial, 160))
        && (!('sanitaryVerification' in c)
            || (c.sanitaryVerification is map && isValidSanitaryVerification(c.sanitaryVerification)));
    }

    // `orderTotal` and `customerRut` are passed in: the persisted breakdown and
    // the fiscal RUT are client-writable artifacts, so they are pinned to the
    // order's own figures — a crafted document could otherwise carry a fiscal
    // total (or tax identity) that contradicts what was actually charged.
    function isValidBilling(b, orderTotal, customerRut) {
      return b.keys().hasOnly([
          'documentType', 'rut', 'razonSocial', 'giroComercial',
          'direccionFiscal', 'comunaFiscal', 'taxBreakdown', 'status'
        ])
        && b.documentType == 'boleta'
        && isBoundedString(b.rut, 16)
        && b.rut == customerRut
        && isBoundedString(b.direccionFiscal, 200)
        && isBoundedString(b.comunaFiscal, 80)
        && b.taxBreakdown is map && isValidTaxBreakdown(b.taxBreakdown)
        && b.taxBreakdown.total == orderTotal
        // The SII emission state is server-owned: a client may only ever open a
        // document as PENDIENTE_EMISION_SII — never as EMITIDO.
        && b.status == 'PENDIENTE_EMISION_SII'
        && (!('razonSocial' in b) || isBoundedString(b.razonSocial, 160))
        && (!('giroComercial' in b) || isBoundedString(b.giroComercial, 160));
    }

    // The path variable is passed in: a rules function cannot see the capture
    // variables of the match block that calls it.
    function isValidOrderCreate(orderId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'orderId', 'createdAt', 'paymentMethod', 'status', 'totalAmount',
          'customer', 'billing', 'sanitaryVerification', 'items',
          'promoCode', 'discountAmount'
        ])
        // The document id IS the canonical order id (see api/_lib/orderLookup.ts):
        // binding the field to the path kills the decoy-document shadowing vector.
        // The format is pinned to the generator's exact shape — `PRONTO-` plus 8
        // Crockford base32 characters (no I, L, O, U) — so an id can never carry a
        // character that a path sanitizer would strip, which is what let a crafted
        // id collide into another order's voucher folder (see
        // api/_lib/voucherStorage.ts sanitizeOrderIdForPath). Legacy `PRONTO-NNNNNN`
        // ids are never re-created, so they are not accepted here.
        && data.orderId is string
        && data.orderId.matches('^PRONTO-[0-9A-HJKMNP-TV-Z]{8}$')
        && data.orderId == orderId
        // serverTimestamp() resolves at commit time on the server and rules
        // evaluate against that same request.time — including for a write the
        // browser queued while offline (both clock in at sync/commit time) —
        // so the persisted marker always lands inside this window. Only a
        // caller-chosen literal timestamp (arbitrary past/future value) falls
        // outside it.
        && data.createdAt is timestamp
        && data.createdAt > request.time - duration.value(15, 'm')
        && data.createdAt < request.time + duration.value(15, 'm')
        && data.totalAmount is int && data.totalAmount > 0
        && data.paymentMethod in ['mercadopago', 'transferencia', 'whatsapp']
        && data.status in [
          'PENDIENTE_PAGO_MERCADOPAGO',
          'PENDIENTE_TRANSFERENCIA',
          'COTIZACION_SOLICITADA_WHATSAPP'
        ]
        // submitOrder() derives the status from the payment method — they must agree.
        && (
          (data.paymentMethod == 'mercadopago' && data.status == 'PENDIENTE_PAGO_MERCADOPAGO')
          || (data.paymentMethod == 'transferencia' && data.status == 'PENDIENTE_TRANSFERENCIA')
          || (data.paymentMethod == 'whatsapp' && data.status == 'COTIZACION_SOLICITADA_WHATSAPP')
        )
        && data.customer is map && isValidCustomer(data.customer, data.paymentMethod)
        && (!('billing' in data)
            || (data.billing is map
                && isValidBilling(data.billing, data.totalAmount, data.customer.rut)))
        && (!('sanitaryVerification' in data)
            || (data.sanitaryVerification is map && isValidSanitaryVerification(data.sanitaryVerification)))
        && (!('promoCode' in data) || isBoundedString(data.promoCode, 32))
        && (!('discountAmount' in data) || (data.discountAmount is int && data.discountAmount >= 0))
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 25
        // Shape-check ALL 25 lines (index-guarded — rules cannot loop over a
        // list). The documented evaluation budget is 1,000 expressions per
        // request (function calls are limited by depth, not count); a full
        // 25-line create evaluates well under 400, so no line is left to the
        // webhook's catalog recomputation. Prices remain server-authoritative
        // in create-preference and the webhook — these are shape guards only.
        && (data.items.size() < 1 || isValidOrderItem(data.items[0]))
        && (data.items.size() < 2 || isValidOrderItem(data.items[1]))
        && (data.items.size() < 3 || isValidOrderItem(data.items[2]))
        && (data.items.size() < 4 || isValidOrderItem(data.items[3]))
        && (data.items.size() < 5 || isValidOrderItem(data.items[4]))
        && (data.items.size() < 6 || isValidOrderItem(data.items[5]))
        && (data.items.size() < 7 || isValidOrderItem(data.items[6]))
        && (data.items.size() < 8 || isValidOrderItem(data.items[7]))
        && (data.items.size() < 9 || isValidOrderItem(data.items[8]))
        && (data.items.size() < 10 || isValidOrderItem(data.items[9]))
        && (data.items.size() < 11 || isValidOrderItem(data.items[10]))
        && (data.items.size() < 12 || isValidOrderItem(data.items[11]))
        && (data.items.size() < 13 || isValidOrderItem(data.items[12]))
        && (data.items.size() < 14 || isValidOrderItem(data.items[13]))
        && (data.items.size() < 15 || isValidOrderItem(data.items[14]))
        && (data.items.size() < 16 || isValidOrderItem(data.items[15]))
        && (data.items.size() < 17 || isValidOrderItem(data.items[16]))
        && (data.items.size() < 18 || isValidOrderItem(data.items[17]))
        && (data.items.size() < 19 || isValidOrderItem(data.items[18]))
        && (data.items.size() < 20 || isValidOrderItem(data.items[19]))
        && (data.items.size() < 21 || isValidOrderItem(data.items[20]))
        && (data.items.size() < 22 || isValidOrderItem(data.items[21]))
        && (data.items.size() < 23 || isValidOrderItem(data.items[22]))
        && (data.items.size() < 24 || isValidOrderItem(data.items[23]))
        && (data.items.size() < 25 || isValidOrderItem(data.items[24]))
        && !('mercadopagoPaymentId' in data)
        && !('paidAt' in data);
    }

    // Products catalog (Production & Development/QA):
    // Public read-only access for storefront visitors.
    // Writes restricted exclusively to authenticated administrators.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /dev_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders (Production & Development/QA):
    // Storefront checkout can create initial pending orders, pinned to the exact
    // `submitOrder()` shape and to the document's own id.
    // Read, update, and delete are strictly forbidden from client SDKs.
    // Backend updates (payment approvals & inventory deductions) run exclusively
    // via Firebase Admin SDK (which inherently bypasses security rules).
    match /orders/{orderId} {
      allow create: if isValidOrderCreate(orderId);
      allow read, update, delete: if false;
    }
    match /dev_orders/{orderId} {
      allow create: if isValidOrderCreate(orderId);
      allow read, update, delete: if false;
    }

    // Order Lifecycle & Audit History (Production & Development/QA):
    // Append-only tamper-proof log.
    // Read-only for authenticated administrators; client-side writes forbidden.
    match /order_status_history/{historyId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /dev_order_status_history/{historyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Inventory Audit Logs (Production & Development/QA):
    // Append-only stock adjustment and catalog changes log.
    // Read-only for authenticated administrators; client-side writes forbidden.
    match /inventory_audit_logs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /dev_inventory_audit_logs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
