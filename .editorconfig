root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,mjs,cjs,json,css,html}]
indent_style = space
indent_size = 2

# Prose docs are hand-authored and excluded from Prettier; leave their trailing
# whitespace alone so they stay byte-stable.
[*.md]
trim_trailing_whitespace = false
