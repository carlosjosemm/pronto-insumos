{
  "name": "medical-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "setup:admin": "pnpm dlx tsx scripts/setup-admin.ts",
    "schema:validate": "pnpm dlx tsx scripts/manage-firestore-schema.ts --validate --env=prod",
    "schema:validate:dev": "pnpm dlx tsx scripts/manage-firestore-schema.ts --validate --env=dev",
    "schema:seed": "pnpm dlx tsx scripts/manage-firestore-schema.ts --seed --env=prod",
    "schema:seed:dev": "pnpm dlx tsx scripts/manage-firestore-schema.ts --seed --env=dev",
    "schema:purge-and-seed": "pnpm dlx tsx scripts/manage-firestore-schema.ts --purge-and-seed --env=prod",
    "schema:purge:dev": "pnpm dlx tsx scripts/manage-firestore-schema.ts --purge-and-seed --force --env=dev",
    "catalog:import": "pnpm dlx tsx scripts/import-catalog-csv.ts --env=prod",
    "catalog:import:dev": "pnpm dlx tsx scripts/import-catalog-csv.ts --env=dev"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.70.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "jose": "^5.10.0"
    }
  }
}
