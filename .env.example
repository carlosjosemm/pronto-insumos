# PRONTO INSUMOS ODONTOLÓGICOS - Environment Template
# Copy this file to .env.local and fill in your actual credentials

# Firebase Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Firebase App Check (abuse friction for the public orders create path — NOT
# authentication, NOT price validation). Obtain the site key from the Firebase
# Console (Project Settings -> App Check -> Apps -> your web app -> reCAPTCHA
# v3 provider; the v3 provider needs no billing). When this variable is set,
# the storefront initializes App Check before Firestore and every SDK request
# carries an attestation token; once the Console enforces App Check for
# Firestore, unattested writes (scripted abuse) are rejected. Leaving it unset
# logs a loud error in a production runtime and a warning in dev — the
# storefront keeps working while App Check stays unenforced.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY

# Optional: a specific App Check debug token registered in the Firebase
# Console (App Check -> Apps -> Manage debug tokens). Outside a production
# runtime the storefront enables debug mode automatically; when this variable
# is empty it sets FIREBASE_APPCHECK_DEBUG_TOKEN = true so the SDK prints a
# fresh registration token to the browser console. Never enable debug tokens
# in a production runtime.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Firestore Environment Isolation (Optional: 'development' | 'production'. Defaults to 'development' on local dev)
# In 'development', collections are prefixed as 'dev_products', 'dev_orders', etc.
VITE_FIRESTORE_ENV=development
FIRESTORE_ENV=development

# WhatsApp Integration (Melipilla Business Number - format 569XXXXXXXX)
VITE_WHATSAPP_NUMBER=56929831595

# Mercado Pago Chile Frontend Integration
VITE_MERCADOPAGO_PUBLIC_KEY=YOUR_MERCADOPAGO_PUBLIC_KEY

# Mercado Pago Server-Side Secret Tokens (Vercel Serverless Function)
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=YOUR_MERCADOPAGO_WEBHOOK_SECRET

# Payment Simulation Policy (Server-Side, Optional)
# Simulated checkouts / unverified webhook signatures are automatically disabled when
# VERCEL_ENV=production. Set to "true" ONLY for a controlled demo deployment — never
# for the real storefront.
ALLOW_SIMULATED_PAYMENTS=false

# Payment Simulation Policy (Client-Side, Optional)
# Client adapters simulate endpoint absence only outside a production build; the
# VITE_VERCEL_ENV define is injected by vite.config.ts from VERCEL_ENV. Set to "true"
# ONLY for a controlled demo deployment — never for the real storefront.
VITE_ALLOW_SIMULATED_PAYMENTS=false

# Google Firebase Admin SDK (Vercel Serverless Functions - Node.js process.env ONLY)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_FIREBASE_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
 
# Transactional Email (Resend - Vercel Serverless Functions, process.env ONLY)
# Obtain from: https://resend.com/api-keys -> Create API Key
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM="PRONTO Insumos <pedidos@prontoinsumos.com>"
WAREHOUSE_NOTIFICATION_EMAIL=bodega@prontoinsumos.com

# Canonical Storefront Origin (Vercel Serverless Functions, process.env ONLY)
# The trusted base URL used to build absolute links server-side: order-tracking
# deep links in transactional emails, and — in a production runtime — the
# Mercado Pago return URLs (back_urls) plus the payment-webhook destination of
# every checkout preference. create-preference honors SITE_URL ONLY when
# VERCEL_ENV=production and fails closed without it there, rather than trusting
# the caller-controlled Host header; outside production the request Host is
# used only when it is a safe shape (localhost, *.vercel.app, private LAN IPs)
# and a leaked SITE_URL value is deliberately ignored, so syncing this to a
# preview target cannot repoint preview payments at production.
#   pnpm run env:sync -- --target production --apply
SITE_URL=https://prontoinsumos.com

# Cloud Storage for Firebase — bank-transfer voucher bucket (Task 2.9)
# Requires the Blaze plan (Cloud Storage is unavailable on Spark). Optional override:
# defaults to <FIREBASE_PROJECT_ID>.firebasestorage.app
# After enabling Blaze, apply the browser-upload CORS config once (dry run by default):
#   pnpm run storage:cors -- --apply        # no Cloud SDK required
#   gcloud storage buckets update gs://<bucket> --cors-file=scripts/storage-cors.json
# and deploy the deny-all storage rules:
#   pnpm run deploy:storage-rules
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app

# Bank Transfer Configuration (Optional overrides for Banco de Chile account)
VITE_BANK_NAME="Banco de Chile"
VITE_BANK_ACCOUNT_TYPE="Cuenta Corriente"
VITE_BANK_ACCOUNT_NUMBER="849-01284-01"
VITE_BANK_RUT="77.892.410-2"
VITE_BANK_COMPANY_NAME="PRONTO INSUMOS ODONTOLÓGICOS SPA"
VITE_BANK_EMAIL="pagos@prontoinsumos.cl"

